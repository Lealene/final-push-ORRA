# =============================================================================
# Root env example
# Copy per-workspace as .env.local (Next.js apps auto-load it).
# Production values live in Vercel / Railway.
# =============================================================================

# -----------------------------------------------------------------------------
# Shared local infra (docker-compose.yml)
# -----------------------------------------------------------------------------
# Local docker-compose exposes Postgres on 5434 to avoid clashing with a system
# Postgres on 5432. Production (Railway) uses the standard 5432 endpoint.
DATABASE_URL=postgres://app:app@localhost:5434/app

# -----------------------------------------------------------------------------
# apps/web — @app/web
# -----------------------------------------------------------------------------
NEXT_PUBLIC_SITE_URL=http://localhost:3000
NEXT_PUBLIC_BACKEND_URL=http://localhost:3001
NEXT_PUBLIC_SENTRY_DSN=

# Server-only
SENTRY_AUTH_TOKEN=
AXIOM_TOKEN=
AXIOM_DATASET=

# -----------------------------------------------------------------------------
# apps/backend — @app/backend (Payload v3)
# -----------------------------------------------------------------------------
PAYLOAD_SECRET=replace-with-openssl-rand-base64-32
PAYLOAD_PUBLIC_SERVER_URL=http://localhost:3001
# Reuses DATABASE_URL above.
SENTRY_DSN=
# AXIOM_TOKEN / AXIOM_DATASET reuse above.

# -----------------------------------------------------------------------------
# Turborepo Remote Cache (set after `pnpm dlx turbo login && turbo link`)
# -----------------------------------------------------------------------------
TURBO_TOKEN=
TURBO_TEAM=
